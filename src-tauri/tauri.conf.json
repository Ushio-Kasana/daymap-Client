{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymap",
  "version": "0.1.4",
  "identifier": "com.daymap.client.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daymap",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A fast desktop client for Daymap",
    "longDescription": "An unofficial desktop client for Daymap. Sign in through your school's own Daymap page to view tasks, lessons and school notices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": {
          "width": 560,
          "height": 320
        },
        "appPosition": {
          "x": 150,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 180
        }
      }
    }
  }
}
